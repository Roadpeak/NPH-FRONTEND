# Points at the API. Defaults to http://localhost:4400/api/v1.
NEXT_PUBLIC_API_URL="http://localhost:4400/api/v1"

# Lets the contract tests complete a real MFA login by reading the code the
# API's console SMS provider already printed. Must match the API's
# TEST_HOOK_SECRET exactly.
#
# Without it the authenticated contract tests SKIP; with CONTRACT_REQUIRED=1
# they fail instead, so CI cannot pass by checking nothing.
#
# Development only. The API does not register the hook when NODE_ENV=production.
TEST_HOOK_SECRET=""

# Makes the authenticated contract tests FAIL rather than skip when they
# cannot reach the API. Set this in CI: without it a broken or unreachable
# backend produces a green build that verified nothing.
CONTRACT_REQUIRED=""
